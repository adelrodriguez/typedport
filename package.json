{
  "name": "typeport",
  "version": "0.1.0",
  "description": "Type-safe, Proxy-based RPC from a Standard Schema contract tree — a transport-agnostic core for adapters like Electron IPC and QStash",
  "keywords": [
    "arktype",
    "contract",
    "ipc",
    "proxy",
    "rpc",
    "schema",
    "standard-schema",
    "type-safe",
    "typescript",
    "valibot",
    "zod"
  ],
  "homepage": "https://github.com/adelrodriguez/typeport#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/typeport/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/typeport.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js",
      "default": "./dist/wire.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "tsdown",
    "bump:deps": "pnpm update --interactive --latest",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "pnpm run build && changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "changeset version && pnpm run format"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.0",
    "adamantite": "^0.35.0",
    "hono": "^4.13.2",
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@12.0.0-rc.6"
}
