{
  "name": "typeport",
  "version": "0.1.0",
  "description": "Type-safe, Proxy-based RPC from a Standard Schema contract tree — a transport-agnostic core for adapters like Electron IPC and QStash",
  "keywords": [
    "contract",
    "ipc",
    "proxy",
    "rpc",
    "schema",
    "standard-schema",
    "type-safe",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/adelrodriguez/conduit#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/conduit/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/conduit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "tsdown",
    "bump:deps": "pnpm update --interactive --latest",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "bun test --parallel",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "version": "changeset version && pnpm run format"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/bun": "^1.3.14",
    "adamantite": "^0.35.0",
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@12.0.0-rc.6"
}
