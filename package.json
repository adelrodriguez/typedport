{
  "name": "typedport",
  "version": "0.4.0",
  "description": "Type-safe RPC from a Standard Schema contract, over any transport: Electron IPC, workers, WebSockets, HTTP, or message queues",
  "keywords": [
    "arktype",
    "contract",
    "ipc",
    "proxy",
    "rpc",
    "schema",
    "standard-schema",
    "type-safe",
    "typescript",
    "valibot",
    "zod"
  ],
  "homepage": "https://github.com/adelrodriguez/typedport#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/typedport/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/typedport.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js",
      "default": "./dist/wire.js"
    },
    "./wire/message-port": {
      "types": "./dist/wire/message-port.d.ts",
      "import": "./dist/wire/message-port.js",
      "default": "./dist/wire/message-port.js"
    },
    "./wire/web-socket": {
      "types": "./dist/wire/web-socket.d.ts",
      "import": "./dist/wire/web-socket.js",
      "default": "./dist/wire/web-socket.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze --strict",
    "build": "tsdown",
    "build:verify": "pnpm run build && node scripts/verify-build.ts",
    "bump:deps": "pnpm update --interactive --latest",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "release": "changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version": "changeset version && pnpm run fix"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "@upstash/qstash": "^2.12.0",
    "@upstash/workflow": "^1.3.3",
    "@vitest/coverage-v8": "^4.0.0",
    "adamantite": "^0.42.0",
    "capnweb": "^0.12.0",
    "hono": "^4.13.2",
    "knip": "^6.32.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@12.0.0-rc.6"
}
